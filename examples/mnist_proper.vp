# Velox Proxima (VP) — MNIST Proper (non-linear)
# This model uses non-linearities (ReLU) to reach >97% accuracy.

layer Dense (512)
layer ReLU ()
layer Dense (?)
layer ReLU ()
layer Dense (256)
layer ReLU ()
layer Dropout (0.2)
layer Dense (128)
layer ReLU ()
layer Dense (10)

train on mnist
optimizer adam lr=0.001
epochs 15
batch_size 64
loss cross_entropy
save models/mnist_proper.pt
plot all to plots/mnist_proper.png
eval on test
